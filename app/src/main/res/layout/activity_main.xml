<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:paddingHorizontal="8dp"
            android:text="@string/app_name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="32sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="8dp"
            android:text="@string/main_subtitle"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="15sp" />

        <!-- 줄 전체가 스위치다. 스위치 자체는 표시만 한다. -->
        <LinearLayout
            android:id="@+id/usb_row"
            style="@style/Card"
            android:background="@drawable/card_clickable"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/usb_debugging" />

                <TextView
                    android:id="@+id/usb_state"
                    style="@style/CardBody"
                    android:text="@string/state_off" />
            </LinearLayout>

            <Switch
                android:id="@+id/usb_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/permission_title"
                style="@style/CardTitle"
                android:text="@string/permission_required" />

            <LinearLayout
                android:id="@+id/permission_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/CardBody"
                    android:text="@string/permission_guide" />

                <TextView
                    android:id="@+id/grant_command"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/code_bg"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/copy_command"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="@string/copy_command" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/widget_section" />

            <TextView
                style="@style/CardBody"
                android:text="@string/widget_guide" />

            <Button
                android:id="@+id/add_widget"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="@string/add_widget" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="8dp"
            android:text="@string/notes"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
